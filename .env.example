# Application
ECHOMIND_ENVIRONMENT=development
ECHOMIND_LOG_LEVEL=INFO
DOCUMENTS_PATH=/data/documents
EXTRACTIONS_PATH=/data/extractions
API_PORT=8000

# Structured extraction. Set these only when you intentionally use the OpenAI provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Semantic retrieval of extracted claims.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Neo4j (the defaults match docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=echomind-local-password

# Optional host-port overrides for Docker Compose
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
